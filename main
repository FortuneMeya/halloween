<div class="toast" id="toast" aria-live="polite"></div>

<script>
(() => {
  const SECRET="07202023", STORE="jaz-fortune-halloween-scrapbook";
  const initial={
    year:2026,month:9,selected:"2026-10-12",
    movies:[
      {id:"nun",title:"The Nun",watched:true},
      {id:"shining",title:"The Shining",watched:true},
      {id:"conjuring",title:"The Conjuring",watched:false}
    ],
    events:[
      {id:"leprechaun",title:"Leprechaun 1",date:"2026-10-01",watched:true},
      {id:"nun",title:"The Nun",date:null,watched:true,note:"Watched last week · date not pinned"},
      {id:"shining",title:"The Shining",date:null,watched:true,note:"Watched last week · date not pinned"},
      {id:"conjuring",title:"The Conjuring",date:"2026-10-12",watched:false}
    ],photo:""
  };
  let state;
  try{state=JSON.parse(localStorage.getItem(STORE))||JSON.parse(JSON.stringify(initial))}
  catch{state=JSON.parse(JSON.stringify(initial))}
  const $=id=>document.getElementById(id);
  const months=["January","February","March","April","May","June","July","August","September","October","November","December"];
  const pad=n=>String(n).padStart(2,"0");
  const dateKey=(y,m,d)=>`${y}-${pad(m+1)}-${pad(d)}`;
  function save(){try{localStorage.setItem(STORE,JSON.stringify(state))}catch{}}
  function toast(text){const t=$("toast");t.textContent=text;t.classList.add("show");clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.classList.remove("show"),1800)}

  function unlock(){
    if($("password").value.trim()===SECRET){
      $("gate").style.display="none";
      $("app").style.display="block";
      requestAnimationFrame(()=>$("app").style.opacity="1");
    }else{
      $("feedback").textContent='Nope. Hint: “anniversary”';
      $("password").value="";
      $("gateCard").classList.remove("shake");
      void $("gateCard").offsetWidth;
      $("gateCard").classList.add("shake");
      $("password").focus();
    }
  }
  $("unlockButton").addEventListener("click",unlock);
  $("password").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();unlock()}});

  function renderMovies(){
    const list=$("movieList");list.innerHTML="";
    const unwatched=state.movies.filter(m=>!m.watched);
    $("watchCount").textContent=`${unwatched.length} left`;
    if(!unwatched.length)list.innerHTML='<p class="small-note">Nothing left on the list. Add another?</p>';
    unwatched.forEach(m=>{
      const card=document.createElement("div");card.className="movie";card.draggable=true;
      card.innerHTML='<div class="movie-art">🎞️</div><div class="movie-info"><strong></strong><small>Drag to pick a night</small></div><span class="grip">⠿</span>';
      card.querySelector("strong").textContent=m.title;
      card.addEventListener("dragstart",e=>{e.dataTransfer.setData("text/plain",m.id);e.dataTransfer.effectAllowed="move"});
      card.addEventListener("click",()=>schedule(m.id,state.selected||"2026-10-12"));
      list.appendChild(card);
    });
  }
  function renderHistory(){
    const list=$("historyList");list.innerHTML="";
    const history=state.events.filter(e=>e.watched);
    $("watchedCount").textContent=`${history.length}`;
    history.forEach(ev=>{
      const row=document.createElement("div");row.className="history-item";
      const when=ev.date?new Date(ev.date+"T12:00:00").toLocaleDateString(undefined,{month:"short",day:"numeric"}):(ev.note||"Watched last week");
      row.innerHTML='<span class="history-check">✓</span><div><strong></strong><small></small></div>';
      row.querySelector("strong").textContent=ev.title;row.querySelector("small").textContent=when;list.appendChild(row);
    });
  }
  function renderCalendar(){
    $("monthName").textContent=months[state.month];$("yearName").textContent=state.year;
    const grid=$("calendarGrid");grid.innerHTML="";
    const offset=new Date(state.year,state.month,1).getDay(),days=new Date(state.year,state.month+1,0).getDate(),prevDays=new Date(state.year,state.month,0).getDate();
    const total=Math.ceil((offset+days)/7)*7;
    for(let i=0;i<total;i++){
      let y=state.year,m=state.month,d,other=false;
      if(i<offset){d=prevDays-offset+i+1;m--;other=true;if(m<0){m=11;y--}}
      else if(i>=offset+days){d=i-offset-days+1;m++;other=true;if(m>11){m=0;y++}}
      else d=i-offset+1;
      const date=dateKey(y,m,d),cell=document.createElement("div");cell.className="day";
      if(other)cell.classList.add("other");if(date==="2026-10-12")cell.classList.add("today");if(date===state.selected)cell.classList.add("selected");
      const row=document.createElement("div");row.className="date-row";
      const num=document.createElement("span");num.className="day-number";num.textContent=d;row.appendChild(num);
      if(date==="2026-10-12"){const label=document.createElement("span");label.className="tonight";label.textContent="Tonight";row.appendChild(label)}
      cell.appendChild(row);
      const events=document.createElement("div");events.className="events";
      state.events.filter(ev=>ev.date===date).forEach(ev=>{
        const btn=document.createElement("button");btn.type="button";btn.className="event"+(ev.watched?" watched":"");
        btn.innerHTML="<strong></strong><small></small>";btn.querySelector("strong").textContent=ev.title;
        btn.querySelector("small").textContent=ev.watched?"Watched ✓":"Movie night · click when done";
        btn.addEventListener("click",e=>{
          e.stopPropagation();ev.watched=!ev.watched;
          const movie=state.movies.find(x=>x.id===ev.id);if(movie)movie.watched=ev.watched;
          save();render();
        });
        events.appendChild(btn);
      });
      cell.appendChild(events);
      cell.addEventListener("click",()=>{state.selected=date;save();document.querySelectorAll(".day.selected").forEach(x=>x.classList.remove("selected"));cell.classList.add("selected")});
      cell.addEventListener("dragover",e=>{e.preventDefault();cell.classList.add("drop-target")});
      cell.addEventListener("dragleave",()=>cell.classList.remove("drop-target"));
      cell.addEventListener("drop",e=>{e.preventDefault();cell.classList.remove("drop-target");const id=e.dataTransfer.getData("text/plain");if(id)schedule(id,date)});
      grid.appendChild(cell);
    }
  }
  function render(){renderMovies();renderHistory();renderCalendar()}
  function schedule(id,date){
    const movie=state.movies.find(m=>m.id===id);if(!movie)return;
    let ev=state.events.find(x=>x.id===id);
    if(!ev){ev={id,title:movie.title,date,watched:false};state.events.push(ev)}
    ev.title=movie.title;ev.date=date;ev.watched=false;delete ev.note;movie.watched=false;state.selected=date;save();render();toast(`${movie.title} added to the calendar`);
  }
  $("addForm").addEventListener("submit",e=>{
    e.preventDefault();const input=$("newMovie"),title=input.value.trim();if(!title)return;
    state.movies.push({id:"movie-"+Date.now(),title,watched:false});input.value="";save();renderMovies();toast("Added to the list");
  });
  $("prevMonth").onclick=()=>{state.month--;if(state.month<0){state.month=11;state.year--}save();renderCalendar()};
  $("nextMonth").onclick=()=>{state.month++;if(state.month>11){state.month=0;state.year++}save();renderCalendar()};
  $("goToday").onclick=()=>{state.year=2026;state.month=9;state.selected="2026-10-12";save();renderCalendar()};
  $("photoInput").addEventListener("change",e=>{
    const file=e.target.files&&e.target.files[0];if(!file)return;
    const reader=new FileReader();reader.onload=()=>{
      state.photo=reader.result;$("heroPhoto").src=state.photo;$("hero").classList.add("has-photo");
      $("photoFrame").innerHTML="";const img=document.createElement("img");img.src=state.photo;$("photoFrame").appendChild(img);save();
    };reader.readAsDataURL(file);
  });
  if(state.photo){$("heroPhoto").src=state.photo;$("hero").classList.add("has-photo");$("photoFrame").innerHTML="";const img=document.createElement("img");img.src=state.photo;$("photoFrame").appendChild(img)}
  render();
})();
</script>
</body>
</html>
